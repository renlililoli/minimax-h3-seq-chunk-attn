# Image build and selection. Keep the validated digest unless the same image
# is mirrored to another registry.
COMFYUI_BASE_IMAGE=comfyui@sha256:4708ab49a718640950f5cd698172d4800718d3b62e961f79d20866c115a8cff5
IMAGE_NAME=minimax-h3-seqattn:comfyui-0.30.0-cu128-rtx50

# Host resources and bind mounts.
GPU_ID=0
HOST_PORT=8188
MODELS_DIR=/absolute/path/to/ComfyUI/models
INPUT_DIR=/absolute/path/to/ComfyUI/input
OUTPUT_DIR=/absolute/path/to/ComfyUI/output
USER_DIR=/absolute/path/to/ComfyUI/user

# ComfyUI server and DynamicVRAM settings.
COMFYUI_LISTEN=0.0.0.0
COMFYUI_PORT=8188
COMFYUI_ENABLE_DYNAMIC_VRAM=1
COMFYUI_DISABLE_NVML_PRESSURE=0
COMFYUI_DISABLE_ASYNC_OFFLOAD=0
COMFYUI_ASYNC_OFFLOAD_STREAMS=
COMFYUI_RESERVE_VRAM_GIB=
COMFYUI_VRAM_HEADROOM_GIB=
COMFYUI_EXTRA_ARGS=

# CUDA, allocator, cache, and diagnostics.
CUDA_MODULE_LOADING=LAZY
PYTORCH_ALLOC_CONF=expandable_segments:True
MALLOC_ARENA_MAX=2
MALLOC_MMAP_THRESHOLD_=131072
MALLOC_TRIM_THRESHOLD_=0
XDG_CACHE_HOME=/opt/ComfyUI/user/.cache
TORCHINDUCTOR_CACHE_DIR=/opt/ComfyUI/user/.cache/torchinductor
SEQATTN_CONFIG=/etc/seqattn/config.toml
SEQATTN_ENABLE_NVTX=0
